/// The rows of the upstream, with the numbers the upstream computes on them.
///
/// The rows are the ones of the generator of the upstream
/// `dowhy.datasets.linear_dataset`, which the tests of the upstream of the
/// estimators use with the seed of the fixture `fixed_seed` of the upstream,
/// which seeds the generator of numpy with zero. The data set has one common
/// cause, one instrument, one treatment and a continuous outcome.
///
/// The numbers are the ones the estimator of the upstream computes on these
/// rows: the average treatment effect, the bounds of its confidence interval
/// and its standard error. The test of the port runs its own estimator on
/// these rows and asserts that the two numbers are the same number.
///
/// The file comes from the upstream reference of the estimators, which
/// `_verify/gen_upstream_estimator_testdata.py` generates; do not edit it by
/// hand.

///|
/// The average treatment effect the upstream computes on the rows.
pub const UPSTREAM_ATE : Double = 9.99895134363435

///|
/// The lower bound of the confidence interval the upstream computes.
pub const UPSTREAM_CI_LOWER : Double = 9.997929501691063

///|
/// The upper bound of the confidence interval the upstream computes.
pub const UPSTREAM_CI_UPPER : Double = 9.999973185577632

///|
/// The standard error the upstream computes on the rows.
pub const UPSTREAM_STANDARD_ERROR : Double = 0.0005210415232464042

///|
/// The true average treatment effect of the data set.
pub const UPSTREAM_TRUE_ATE : Double = 10.000512614385439

