    ["Z1", "Z2", "Z3", "X", "Y", "M1", "M2"],
    [],
    [],
    Some(["Z3"]),
    Some(["Z3"]),
    Some(["Z3"]),
  )
}

///|
/// The taheri_graph2 graph of the upstream test suite.
fn efficient_case_taheri_graph2() -> EfficientTestCase {
  EfficientTestCase::new(
    ["Z1", "Z2", "Z3", "Z4", "Z5", "M1", "M2", "M3", "X", "Y", "U1", "U2"],
    [
      "Z1->Z2", "Z2->Z3", "Z3->Z4", "Z4->Z5", "Z5->Y", "Z1->X", "X->M1", "M1->M2",
      "M2->M3", "M3->Y", "U1->X", "U1->Z1", "U2->Z2", "U2->M1",
    ],
    ["Z1", "Z2", "Z3", "Z4", "Z5", "X", "Y", "M1", "M2", "M3"],
    [],
    [],
    Some(["Z1", "Z2", "Z5"]),
    Some(["Z1"]),
    Some(["Z1"]),
  )
}

///|
/// Every example graph of the upstream test suite.
pub fn efficient_cases() -> Array[EfficientTestCase] {
  [
    efficient_case_ssr21_fig6_example_graph(),
    efficient_case_ssr21_fig5_example_graph(),
    efficient_case_ssr21_fig4_example_graph(),
    efficient_case_ssr21_fig3_example_graph(),
    efficient_case_sr22_fig2_example_graph(),
    efficient_case_sr22_fig2_diffcosts_example_graph(),
    efficient_case_sr22_fig3_example_graph(),
    efficient_case_alldiff_example_graph(),
    efficient_case_shrier_platt_2008(),
    efficient_case_taheri_graph1(),
    efficient_case_taheri_graph2(),
  ]
}
