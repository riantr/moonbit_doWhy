      "U->Y", "U->F",
    ],
    ["L", "X", "B", "K", "Q", "R", "M", "T", "Y", "F"],
    ["L"],
    [("L", 1.0), ("B", 2.0), ("K", 4.0), ("Q", 1.0), ("R", 1.0), ("T", 1.0)],
    None,
    Some(["L", "R", "T"]),
    Some(["L", "R", "T"]),
  )
}

