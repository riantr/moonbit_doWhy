///|
/// The alldiff_example_graph graph of the upstream test suite.
fn efficient_case_alldiff_example_graph() -> EfficientTestCase {
  EfficientTestCase::new(
    ["X", "Y", "W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8", "W9", "K", "O"],
    [
      "K->X", "X->Y", "W1->K", "W2->K", "W3->K", "W1->W4", "W2->W5", "W3->W6", "W4->W7",
      "W5->W8", "W6->W9", "W7->Y", "W8->Y", "W9->Y", "O->Y",
    ],
    ["X", "Y", "K", "O", "W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8", "W9"],
    [],
    [
      ("W1", 2.0),
      ("W2", 1.0),
      ("W3", 1.0),
      ("W4", 1.0),
      ("W5", 2.0),
      ("W6", 1.0),
      ("W7", 1.0),
      ("W8", 1.0),
      ("W9", 2.0),
      ("K", 11.0),
      ("O", 1.0),
    ],
    Some(["O", "W7", "W8", "W9"]),
    Some(["W7", "W8", "W9"]),
    Some(["W6", "W7", "W8"]),
  )
}

///|
/// The shrier_platt_2008 graph of the upstream test suite.
fn efficient_case_shrier_platt_2008() -> EfficientTestCase {
  EfficientTestCase::new(
    [
      "coach", "team motivation", "fitness", "pre-game prop", "intra-game prop",
      "neuromusc fatigue", "X", "previous injury", "contact sport", "genetics", "Y",
      "tissue disorder", "tissue weakness",
    ],
    [
      "coach->team motivation", "coach->fitness", "fitness->pre-game prop", "fitness->neuromusc fatigue",
      "team motivation->X", "team motivation->previous injury", "pre-game prop->X",
      "X->intra-game prop", "contact sport->previous injury", "contact sport->intra-game prop",
      "intra-game prop->Y", "genetics->fitness", "genetics->neuromusc fatigue", "genetics->tissue disorder",
      "tissue disorder->neuromusc fatigue", "tissue disorder->tissue weakness", "neuromusc fatigue->intra-game prop",
      "neuromusc fatigue->Y", "tissue weakness->Y",
    ],
    [
      "team motivation", "previous injury", "X", "coach", "fitness", "contact sport",
      "neuromusc fatigue", "tissue disorder", "Y",
    ],
    ["previous injury", "team motivation"],
    [],
    Some([
      "contact sport", "neuromusc fatigue", "previous injury", "team motivation",
      "tissue disorder",
    ]),
    Some([
      "neuromusc fatigue", "previous injury", "team motivation", "tissue disorder",
    ]),
    Some(["fitness", "previous injury", "team motivation"]),
  )
}

