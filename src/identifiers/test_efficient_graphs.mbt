/// The example graphs of the efficient backdoor tests.
///
/// The graphs, the observed variables, the conditional variables, the
/// costs and the expected adjustment sets come from
/// `tests/causal_identifiers/example_graphs_efficient.py` of DoWhy 0.14.
/// The file is generated by
/// `_verify/gen_efficient_backdoor_testdata.py`; do not edit it by hand.

///|
/// One example graph with the adjustment sets it has to produce.
pub struct EfficientTestCase {
  nodes : Array[String]
  edges : Array[String]
  observed_nodes : Array[String]
  conditional_nodes : Array[String]
  costs : Array[(String, Double)]
  efficient : Array[String]?
  efficient_minimal : Array[String]?
  efficient_mincost : Array[String]?
}

///|
/// A new efficient backdoor test case.
pub fn EfficientTestCase::new(
  nodes : Array[String],
  edges : Array[String],
  observed_nodes : Array[String],
  conditional_nodes : Array[String],
  costs : Array[(String, Double)],
  efficient : Array[String]?,
  efficient_minimal : Array[String]?,
  efficient_mincost : Array[String]?,
) -> EfficientTestCase {
  {
    nodes,
    edges,
    observed_nodes,
    conditional_nodes,
    costs,
    efficient,
    efficient_minimal,
    efficient_mincost,
  }
}

///|
/// The ssr21_fig6_example_graph graph of the upstream test suite.
fn efficient_case_ssr21_fig6_example_graph() -> EfficientTestCase {
  EfficientTestCase::new(
    ["X", "F", "T", "U", "Y"],
    ["T->X", "X->Y", "U->Y", "U->F"],
    ["X", "Y", "T", "F"],
    ["T"],
    [],
    None,
    Some(["T"]),
    Some(["T"]),
  )
}

