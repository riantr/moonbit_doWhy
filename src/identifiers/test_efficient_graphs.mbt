      "X->Y", "T->W1", "T->Y", "W1->X", "W2->W1", "W2->Y", "W3->W1", "W3->Y", "W4->Y",
    ],
    ["A", "Y", "T", "W1", "W2", "W3", "W4"],
    ["T"],
    [],
    Some(["T", "W2", "W3", "W4"]),
    Some(["T", "W2", "W3"]),
    Some(["T", "W1"]),
  )
}

