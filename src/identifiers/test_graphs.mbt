    [["V2"], ["V3"]],
  )
}

///|
/// Every backdoor example graph of the upstream test suite.
pub fn backdoor_cases() -> Array[IdentifierTestCase] {
  [
    backdoor_case_pearl_backdoor_example_graph(),
    backdoor_case_simple_selection_bias_graph(),
    backdoor_case_simple_no_confounder_graph(),
    backdoor_case_pearl_simpsons_paradox_1c(),
    backdoor_case_pearl_simpsons_paradox_1d(),
    backdoor_case_pearl_simpsons_paradox_2a(),
    backdoor_case_pearl_simpsons_paradox_2b(),
    backdoor_case_pearl_simpsons_paradox_2b_L_observed(),
    backdoor_case_pearl_simpsons_machine_lvl1(),
    backdoor_case_book_of_why_game2(),
    backdoor_case_book_of_why_game5(),
    backdoor_case_book_of_why_game5_C_is_unobserved(),
    backdoor_case_no_treatment_but_valid_maximal_set(),
    backdoor_case_common_cause_of_mediator1(),
    backdoor_case_common_cause_of_mediator2(),
    backdoor_case_mbias_with_unobserved(),
    backdoor_case_iv(),
    backdoor_case_mediator(),
    backdoor_case_mediator_with_conf(),
  ]
}

///|
/// Every frontdoor example graph of the upstream test suite.
pub fn frontdoor_cases() -> Array[FrontdoorTestCase] {
  [
    frontdoor_case_valid_singleton(),
    frontdoor_case_valid_doubleton(),
    frontdoor_case_no_frontdoor(),
    frontdoor_case_no_frontdoor_simple(),
    frontdoor_case_no_frontdoor_in_obs(),
    frontdoor_case_perkovic_example_9_multiple_action_nodes_no_frontdoor(),
  ]
}

///|
/// Every complete adjustment example graph of the upstream test suite.
pub fn complete_cases() -> Array[CompleteTestCase] {
  [
    complete_case_shpitser_simple_non_backdoor_adjustment_set(),
    complete_case_van_der_zander_minimal_non_backdoor_adjustment_set(),
    complete_case_perkovic_example_8(),
    complete_case_perkovic_example_9(),
  ]
}
