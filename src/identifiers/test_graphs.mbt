/// The example graphs of the identifier tests.
///
/// The graphs, the observed variables and the expected adjustment
/// sets come from `tests/causal_identifiers/example_graphs.py` of DoWhy
/// 0.14.  The file is generated by
/// `_verify/gen_identifier_testdata.py`; do not edit it by hand.

///|
/// One example graph with the adjustment sets it has to produce.
pub struct IdentifierTestCase {
  nodes : Array[String]
  edges : Array[String]
  action_nodes : Array[String]
  outcome_nodes : Array[String]
  observed_nodes : Array[String]
  biased_sets : Array[Array[String]]
  minimal_sets : Array[Array[String]]
  maximal_sets : Array[Array[String]]
  direct_maximal_sets : Array[Array[String]]
}

///|
/// A new test case.
pub fn IdentifierTestCase::new(
  nodes : Array[String],
  edges : Array[String],
  action_nodes : Array[String],
  outcome_nodes : Array[String],
  observed_nodes : Array[String],
  biased_sets : Array[Array[String]],
  minimal_sets : Array[Array[String]],
  maximal_sets : Array[Array[String]],
  direct_maximal_sets : Array[Array[String]],
) -> IdentifierTestCase {
  {
    nodes,
    edges,
    action_nodes,
    outcome_nodes,
    observed_nodes,
    biased_sets,
    minimal_sets,
    maximal_sets,
    direct_maximal_sets,
  }
}

///|
/// A frontdoor example graph with the valid and the invalid sets.
pub struct FrontdoorTestCase {
  nodes : Array[String]
  edges : Array[String]
  action_nodes : Array[String]
  outcome_nodes : Array[String]
  observed_nodes : Array[String]
  valid_sets : Array[Array[String]]
  invalid_sets : Array[Array[String]]
}

///|
/// A new frontdoor test case.
pub fn FrontdoorTestCase::new(
  nodes : Array[String],
  edges : Array[String],
  action_nodes : Array[String],
  outcome_nodes : Array[String],
  observed_nodes : Array[String],
  valid_sets : Array[Array[String]],
  invalid_sets : Array[Array[String]],
) -> FrontdoorTestCase {
  {
    nodes,
    edges,
    action_nodes,
    outcome_nodes,
    observed_nodes,
    valid_sets,
    invalid_sets,
  }
}

///|
/// A complete adjustment example graph.
pub struct CompleteTestCase {
  nodes : Array[String]
  edges : Array[String]
  action_nodes : Array[String]
  outcome_nodes : Array[String]
  observed_nodes : Array[String]
  minimal_sets : Array[Array[String]]
}

///|
/// A new complete adjustment test case.
pub fn CompleteTestCase::new(
  nodes : Array[String],
  edges : Array[String],
  action_nodes : Array[String],
  outcome_nodes : Array[String],
  observed_nodes : Array[String],
  minimal_sets : Array[Array[String]],
) -> CompleteTestCase {
  { nodes, edges, action_nodes, outcome_nodes, observed_nodes, minimal_sets, }
}

// ---- the backdoor graphs -------------------------------------------

///|
/// The pearl_backdoor_example_graph graph of the upstream test suite.
fn backdoor_case_pearl_backdoor_example_graph() -> IdentifierTestCase {
  IdentifierTestCase::new(
    ["Z1", "Z2", "Z3", "Z4", "Z5", "Z6", "X", "Y"],
    [
      "Z1->Z3", "Z1->Z4", "Z2->Z4", "Z2->Z5", "Z3->X", "Z4->X", "Z4->Y", "Z5->Y",
      "Z6->Y", "X->Z6",
    ],
    ["X"],
    ["Y"],
    ["Z1", "Z2", "Z3", "Z4", "Z5", "Z6", "X", "Y"],
    [
      ["Z4"],
      ["Z6"],
      ["Z5"],
      ["Z2"],
      ["Z1"],
      ["Z3"],
      ["Z1", "Z3"],
      ["Z2", "Z5"],
      ["Z1", "Z2"],
    ],
    [["Z1", "Z4"], ["Z2", "Z4"], ["Z3", "Z4"], ["Z4", "Z5"]],
    [["Z1", "Z2", "Z3", "Z4", "Z5"]],
    [["Z1", "Z2", "Z3", "Z4", "Z5", "Z6"]],
  )
}

